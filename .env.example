# Environment variables example
OPENAI_API_KEY=
APP_ENV=development

# ---------------------------------------------------------------------------
# Phase 1 – Database (Railway injects DATABASE_URL automatically in prod)
# Local example:
#   postgresql://user:pass@localhost:5432/mentormuni
# Railway / Heroku style postgres:// is also accepted (normalized to asyncpg).
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Phase 1 – Platform API key (frontend sends on every request as X-API-Key)
# Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Put the SAME value in the frontend env (never commit real keys).
# ---------------------------------------------------------------------------
API_KEY=

# REQUIRED: separate from API_KEY (API_KEY is embedded in the frontend).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_EXPIRE_MINUTES=1440

# Dev only: allow Bearer demo.student.* / local.student.* (default off).
# ENABLE_DEMO_STUDENT_AUTH=true

# ---------------------------------------------------------------------------
# Email (Railway: use Resend — Gmail SMTP times out from Railway)
# ---------------------------------------------------------------------------
# 1. Create account at https://resend.com → API Keys → Create
# 2. Domains → add mentormuni.com (or use beth.t@example.com for sandbox tests only)
# 3. Railway variables:
#      EMAIL_ENABLED=true
#      RESEND_API_KEY=re_xxxxxxxx
#      EMAIL_FROM_ADDRESS=noreply@mentormuni.com   # must match verified Resend domain
#      EMAIL_FROM_NAME=MentorMuni Team
#      ORG_PORTAL_BASE_URL=https://www.mentormuni.com
# Sandbox (sends only to your Resend signup email):
#      EMAIL_FROM_ADDRESS=beth.t@example.com
#
# Optional SMTP fallback (local only — usually blocked on Railway):
#      SMTP_PASSWORD=<Gmail App Password>
#      SMTP_PORT=465
#      SMTP_USE_SSL=true
#      SMTP_USE_TLS=false
EMAIL_ENABLED=false
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@mentormuni.com
# EMAIL_FROM_NAME=MentorMuni Team
# ORG_PORTAL_BASE_URL=https://www.mentormuni.com
# SMTP_PASSWORD=
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false
# SMTP_TIMEOUT_SECONDS=12

# LLM plan endpoints (interview/skill readiness): seconds before 504. Default 120. Raise if OpenAI is slow.
# LLM_TIMEOUT_SECONDS=120

# Resume ATS: use OpenAI for summary/fixes/strengths (scores stay rule-based). false = heuristics only.
# RESUME_ATS_USE_LLM=true

# Optional: where to store contact_submissions.jsonl (default: /tmp)
# DATA_DIR=./data

# OpenAI Realtime voice interview coach (WebRTC ephemeral sessions)
# REALTIME_MODEL=gpt-realtime
# REALTIME_CLIENT_SECRET_TTL_SECONDS=1800
# VOICE_INTERVIEW_ANALYSIS_MODEL=gpt-4.1
# PERSONAL_MENTOR_MODEL=gpt-4.1
# Student-private fear coach (not visible to TPO/HOD; no org persistence)
# KNOW_MY_FEAR_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Coding assessment (Judge0 + dedicated Railway worker — not FastAPI BackgroundTasks)
# ---------------------------------------------------------------------------
# Coding execution (Judge0). Required for C++/Java.
# In APP_ENV=development, if JUDGE0_BASE_URL is empty, Python-only local executor is used.
# JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=
# CODING_EXECUTION_PROVIDER=judge0
# CODING_MAX_SOURCE_BYTES=64000
# CODING_MAX_STDOUT_BYTES=16384
# CODING_RUN_RATE_PER_STUDENT=30
# CODING_RUN_RATE_WINDOW_SECONDS=60
# CODING_SUBMIT_RATE_PER_STUDENT=10
# CODING_SUBMIT_RATE_WINDOW_SECONDS=60
# CODING_EXECUTION_TIMEOUT_MS=2000
# CODING_COMPILE_TIMEOUT_MS=10000
# CODING_MEMORY_LIMIT_KB=128000
# CODING_MAX_CONCURRENT_JOBS=4
# CODING_JOB_MAX_ATTEMPTS=5
# CODING_JOB_POLL_INTERVAL_MS=1500
# CODING_JOB_STALE_SECONDS=300
# CODING_EXECUTION_PROVIDER=judge0
